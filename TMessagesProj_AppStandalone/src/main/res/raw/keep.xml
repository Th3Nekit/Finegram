<?xml version="1.0" encoding="utf-8"?>
<!--
    Ресурсы, которые нужны плагинам, а не клиенту.

    Плагин берёт значок по имени — и по коду клиента этого не видно. Сжатие ресурсов
    выбрасывает такие как неиспользуемые, и плагин падает при обращении к ним. Здесь
    перечислено то, что должно дожить до сборки в любом случае.

    Заодно отключаем замену неиспользуемых ресурсов заглушками: плагины ищут их по именам.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/*"
    tools:shrinkMode="safe" />
